nextflow_process {

    name "Test Process SPLIT_CLOSEST_ORFS"
    script "../main.nf"
    process "SPLIT_CLOSEST_ORFS"

    tag "modules"
    tag "modules_local"
    tag "splitclosestorf"

    test("consensus fasta - similarity csv - genbank") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/resources/split_fastas/PZ661404.1.fasta", checkIfExists: true),
                    file("${projectDir}/tests/resources/similarities_small.csv", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/tests/resources/noro_gb_records.gb", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("consensus fasta - similarity csv - genbank - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/resources/split_fastas/PZ661404.1.fasta", checkIfExists: true),
                    file("${projectDir}/tests/resources/similarities_small.csv", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/tests/resources/noro_gb_records.gb", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
