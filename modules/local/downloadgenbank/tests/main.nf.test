// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test downloadgenbank
nextflow_process {

    name "Test Process DOWNLOADGENBANK"
    script "../main.nf"
    process "DOWNLOAD_GENBANK"

    tag "modules"
    tag "modules_"
    tag "downloadgenbank"

    test("Check basic download creates a file") {

        // TODO nf-core: If you are created a test for a chained module
        // (the module requires running more than one process to generate the required output)
        // add the 'setup' method here.
        // You can find more information about how to use a 'setup' method in the nf-test docs (https://www.nf-test.com/docs/testcases/setup/).

        when {
            process {
                """
                // TODO nf-core: define inputs of the process here. Example:
                
                input[0] = "https://calicivirustypingtool.cdc.gov/gebali.cgi?GII.+gb"
                """
            }
        }

        then {
            assert process.success
            assert process.out.genbank_file.size() == 1
            assert path(process.out.genbank_file.get(0)).exists()
        }

    }

}
