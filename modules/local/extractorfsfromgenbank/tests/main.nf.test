nextflow_process {

    name "Test Process EXTRACT_ORFS_FROM_GENBANK"
    script "../main.nf"
    process "EXTRACT_ORFS_FROM_GENBANK"

    tag "modules"
    tag "modules_local"
    tag "extractorfsfromgenbank"

    test("extract orfs from genbank records") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/resources/noro_gb_records.gb", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("extract orfs from genbank records - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/resources/noro_gb_records.gb", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
