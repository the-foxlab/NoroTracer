nextflow_process {

    name "Test Process EXTRACT_CLOSEST_GENBANK_RECORDS"
    script "../main.nf"
    process "EXTRACT_CLOSEST_GENBANK_RECORDS"

    tag "modules"
    tag "modules_local"
    tag "extractclosestgenbankrecords"

    test("bascic run with consensus fasta, similarity csv and genbank records") {

        when {
            params {
                similarity_topx = 2
            }
            process {
                """
                input[0] = file("${projectDir}/tests/resources/similarities_small.csv", checkIfExists: true)
                input[1] = file("${projectDir}/tests/resources/consensus.fasta", checkIfExists: true)
                input[2] = file("${projectDir}/tests/resources/noro_gb_records.gb", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("bascic run with consensus fasta, similarity csv and genbank records  - stub") {

        options "-stub"

        when {
            params {
                similarity_topx = 2
            }
            process {
                """
                input[0] = file("${projectDir}/tests/resources/similarities_small.csv", checkIfExists: true)
                input[1] = file("${projectDir}/tests/resources/consensus.fasta", checkIfExists: true)
                input[2] = file("${projectDir}/tests/resources/noro_gb_records.gb", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
