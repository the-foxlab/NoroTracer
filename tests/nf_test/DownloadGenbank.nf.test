nextflow_process {

    name "Test Process DownloadGenbank"
    script "modules/local/DownloadGenbank.nf"
    process "DownloadGenbank"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                genbank_download_url = "https://calicivirustypingtool.cdc.gov/gebali.cgi?GII.+gb"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = params.genbank_download_url
                """
            }
        }

        then {
            assert process.success
            assert process.out.genbank_file.size() == 1
            assert path(process.out.genbank_file.get(0)).exists()
        }

    }

}
